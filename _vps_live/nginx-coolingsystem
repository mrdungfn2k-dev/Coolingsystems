server {
    server_name coolingsystem.vn www.coolingsystem.vn;
    root /opt/cooling-php/public;
    index index.php;
    client_max_body_size 170M;
    location /css/ { alias /opt/cooling-php/public/css/; expires 7d; }
    location /js/ { alias /opt/cooling-php/public/js/; expires 7d; }
    location /uploads/ { alias /var/lib/cooling/uploads/; expires 7d; }
    location /static/css/ { alias /opt/cooling-php/public/css/; expires 7d; }
    location /static/js/ { alias /opt/cooling-php/public/js/; expires 7d; }
    location /static/img/ { alias /opt/cooling-php/public/img/; expires 7d; }
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~ \.php$ { include snippets/fastcgi-php.conf; fastcgi_pass unix:/var/run/php/php8.3-fpm.sock; fastcgi_read_timeout 300s; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; include fastcgi_params; }
    location ~ /\.ht { deny all; }
    gzip on; gzip_types text/plain text/css application/javascript application/json image/svg+xml; gzip_min_length 1024;
    access_log /var/log/nginx/cooling.access.log;
    error_log /var/log/nginx/cooling.error.log;
    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/coolingsystem.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/coolingsystem.vn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
server {
    if ($host = coolingsystem.vn) { return 301 https://$host$request_uri; }
    listen 80; listen [::]:80;
    server_name coolingsystem.vn www.coolingsystem.vn;
    return 404;
}
